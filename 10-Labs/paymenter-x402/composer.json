{
    "name": "gentech/paymenter-x402",
    "description": "x402 Crypto Gateway for Paymenter — accept gasless crypto payments via GenTech Labs",
    "type": "paymenter-extension",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "GenTech Labs",
            "email": "hello@gentechlabs.net",
            "homepage": "https://gentechlabs.net"
        }
    ],
    "require": {
        "php": ">=8.1",
        "paymenter/core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Paymenter\\Extensions\\Gateways\\X402\\": "src/"
        }
    },
    "extra": {
        "paymenter": {
            "extension": {
                "type": "gateway",
                "name": "x402",
                "directory": "Gateways/X402"
            }
        }
    }
}
